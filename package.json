{
  "name": "kcuf",
  "version": "0.1.0",
  "type": "module",
  "description": "A mono-repo for common purpose packages.",
  "keywords": [
    "react",
    "lerna",
    "babel",
    "storybook",
    "vitest"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justnewbee/kcuf.git"
  },
  "homepage": "https://github.com/justnewbee/kcuf",
  "bugs": "https://github.com/justnewbee/kcuf/issues",
  "author": {
    "name": "Jianchun Wang",
    "email": "justnewbee@gmail.com"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@kcuf/eslint-config": "workspace:^",
    "@kcuf/markdownlint-config": "workspace:^",
    "@kcuf/npm-package-json-lint-config": "workspace:^",
    "@kcuf/stylelint-config": "workspace:^",
    "@kcuf/ts-config": "workspace:^",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commander": "^15.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "npm-package-json-lint": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "^17.15.0",
    "taze": "^21.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "boot": "pnpm clean && pnpm i --registry https://registry.npmmirror.com",
    "boot:packages": "pnpm -r prepublishOnly",
    "lint": "eslint packages*/*/src/ --ext js,ts,tsx",
    "lint:style": "stylelint \"**/src/**/*.{css,less,ts,tsx}\"",
    "lint:md": "markdownlint-cli2 **/*.md !node_modules",
    "lint:pkg": "pnpm -r --include-workspace-root exec npmPkgJsonLint .",
    "taze": "taze -r",
    "depcheck": "pnpm -r --include-workspace-root --no-bail --filter '!web' exec depcheck",
    "lerna:publish": "lerna publish",
    "lerna:publish:patch": "lerna publish patch",
    "lerna:publish:minor": "lerna publish minor",
    "lerna:publish:canary": "lerna publish --npm-tag=canary --canary=canary"
  }
}
